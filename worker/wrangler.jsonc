{
  "name": "prosolver-hospitals-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "prosolver-hospitals", "database_id": "fef015df-c6fc-4c3a-9f6d-5acf6b3444ad", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "prosolver-hospitals-private-audio" }],
  "ratelimits": [{ "name": "RATE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": { "SITE_ORIGIN": "https://nisongmonyimba.github.io", "PUBLIC_API_URL": "REPLACE_WITH_WORKER_URL", "EMAIL_FROM": "REPLACE_WITH_VERIFIED_SENDER", "PUBLIC_SIGNUPS_ENABLED": "false", "PRIVACY_NOTICE_APPROVED": "false", "SYNTHETIC_TEST_ENABLED": "false", "RETENTION_DAYS": "90" }
}
