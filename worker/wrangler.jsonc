{
  "name": "prosolver-hospitals-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [{ "binding": "DB", "database_name": "prosolver-hospitals", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "prosolver-hospitals-private-audio" }],
  "unsafe": {},
  "ratelimits": [{ "name": "RATE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": { "SITE_ORIGIN": "https://nisongmonyimba.github.io", "PUBLIC_API_URL": "REPLACE_WITH_WORKER_URL", "EMAIL_FROM": "REPLACE_WITH_VERIFIED_SENDER" }
}
